# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# SQL Server connection settings
DB_SERVER=localhost
DB_NAME=dbCDNNLT
DB_USER=sa
DB_PASSWORD=your_password_here

# ==============================================
# GEMINI AI CONFIGURATION
# ==============================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# ==============================================
# FILE SEARCH CONFIGURATION
# ==============================================
# Enable/disable File Search (search documents for context when solving)
USE_FILE_SEARCH=true
# Path to documents folder (relative to project root)
DOCUMENTS_PATH=Documents
# Maximum number of search results to use as context
MAX_SEARCH_RESULTS=3
# Name of the File Search index
FILE_SEARCH_INDEX_NAME=geometry-documents-index

# ==============================================
# API CONFIGURATION
# ==============================================
# API server settings (optional - có giá trị mặc định)
# API_TITLE=API Hệ thống Giải Toán Hình Học 3D
# API_VERSION=1.0.0
# API_DESCRIPTION=API cho hệ thống giải toán hình học không gian 3 chiều sử dụng Gemini AI

# ==============================================
# CORS CONFIGURATION
# ==============================================
# Allowed origins for CORS (optional - mặc định là "*")
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ==============================================
# NOTES
# ==============================================
# 1. Copy file này thành .env và điền thông tin thực tế
# 2. KHÔNG commit file .env lên Git (đã có trong .gitignore)
# 3. Gemini API key miễn phí tại: https://makersuite.google.com/app/apikey
# 4. Database script: chạy file dbCDNNLT.sql trong SQL Server
